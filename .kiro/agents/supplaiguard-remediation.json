{
  "name": "supplaiguard-remediation",
  "description": "SupplAIGuard Remediation agent. Proposes and applies safe, approval-gated fixes (dependency bumps and config tightening) on its own supplaiguard/fix-<scan_id> branch, commits them, and pushes that branch and opens a PR only after asking. Never merges. Writes are scoped to manifests/config and deny secret/prod paths.",
  "prompt": "file://./prompts/remediation.md",
  "mcpServers": {},
  "tools": [
    "read",
    "shell",
    "write"
  ],
  "allowedTools": [
    "read"
  ],
  "toolsSettings": {
    "fs_write": {
      "allowedPaths": [
        "**/package.json",
        "**/package-lock.json",
        "**/mcp.json",
        "**/.kiro/settings/mcp.json",
        ".kiro/agents/**"
      ],
      "deniedPaths": [
        "**/.env",
        "**/.env.*",
        "**/*secret*",
        "**/secrets/**",
        "**/*.pem",
        "**/*.key"
      ]
    },
    "execute_bash": {
      "allowedCommands": [
        "curl -s https://api\\.osv\\.dev/.*",
        "echo .*",
        "jq .*",
        "git status --porcelain",
        "git rev-parse --is-inside-work-tree",
        "git rev-parse --short HEAD",
        "git branch --show-current"
      ],
      "deniedCommands": [
        "rm .*",
        "sudo .*",
        "bash .*",
        "sh .*",
        "git merge .*",
        "gh pr merge .*",
        "git push .*--force.*",
        "git push (.* )?-f( .*)?",
        "git push .*\\+.*",
        "git push .*:.*",
        "git push --(all|mirror|delete|tags).*",
        "git push .* -d .*",
        "git push .* (main|master).*",
        "git push origin HEAD.*",
        "git push -u origin supplaiguard/fix-[^ ]* .*",
        "git branch -D .* .*",
        "git commit .*--amend.*",
        "git reset .*",
        "git rebase .*",
        ".*;.*",
        ".*&&.*",
        ".*\\|\\|.*",
        ".*`.*",
        ".*\\$\\(.*"
      ]
    }
  },
  "resources": [
    "file://~/.kiro/supplaiguard/steering/security-policy.md",
    "file://~/.kiro/supplaiguard/skills/sg-remediation/SKILL.md",
    "file://~/.kiro/supplaiguard/skills/sg-findings-schema/SKILL.md"
  ],
  "hooks": [],
  "useLegacyMcpJson": true,
  "model": null,
  "permissions": {
    "rules": [
      {
        "capability": "shell",
        "match": [
          "curl -s https://api.osv.dev/*",
          "echo *",
          "jq *",
          "git status --porcelain",
          "git rev-parse --is-inside-work-tree",
          "git rev-parse --short HEAD",
          "git branch --show-current"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "npm install *",
          "npm ci",
          "git switch -c supplaiguard/fix-*",
          "git switch *",
          "git add *",
          "git commit -m *",
          "git branch -D supplaiguard/fix-*",
          "git push -u origin supplaiguard/fix-*",
          "gh pr create *"
        ],
        "effect": "ask"
      },
      {
        "capability": "shell",
        "match": [
          "rm *",
          "sudo *",
          "bash *",
          "sh *",
          "git merge *",
          "gh pr merge *",
          "git push *--force*",
          "git push -f*",
          "git push * -f*",
          "git push *+*",
          "git push *:*",
          "git push --all*",
          "git push --mirror*",
          "git push --delete*",
          "git push * -d *",
          "git push --tags*",
          "git push * main*",
          "git push * master*",
          "git push origin HEAD*",
          "git push -u origin supplaiguard/fix-* *",
          "git branch -D * *",
          "git commit *--amend*",
          "git reset *",
          "git rebase *",
          "*;*",
          "*&&*",
          "*||*",
          "*`*",
          "*$(*"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_write",
        "match": [
          "**/package.json",
          "**/package-lock.json",
          "**/mcp.json",
          "**/.kiro/settings/mcp.json",
          ".kiro/agents/**"
        ],
        "effect": "ask"
      },
      {
        "capability": "fs_write",
        "match": [
          "**/.env",
          "**/.env.*",
          "**/*secret*",
          "**/secrets/**",
          "**/*.pem",
          "**/*.key"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_read",
        "effect": "allow"
      },
      {
        "capability": "skill",
        "effect": "allow"
      }
    ]
  },
  "kiroUpgrade": {
    "revision": 2,
    "fingerprint": "sha256:42ae3fd83d0da15c943dc67a6ed182b044be17744580eb58c2d05efb8dea02ed",
    "source": "sha256:0b99d0464ca6f696c13102ef94267b83539b320846bffd6b39e042e3bad526de"
  }
}
